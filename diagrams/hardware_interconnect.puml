@startuml hardware_interconnect
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam linetype ortho

skinparam component {
    BorderColor #1E293B
    BackgroundColor #F8FAFC
    FontColor #0F172A
    FontSize 12
}

' ==================== NODE 2: WIRED VICTIMS (MAKER PI BASES + BREADBOARD) ====================
package "Node 2: Wired Victims (Dual RP2040 on Maker Pi Bases + Breadboard Bus)" as PKG_BREADBOARD #ECFDF5 {
    package "Pico Victim A on Maker Pi Base\n(UART Master / I2C Master)" as PKG_PICO_A #D1FAE5 {
        component "GP0 (UART TX)" as PA_TX #A7F3D0
        component "GP4 (I2C SDA)" as PA_SDA #A7F3D0
        component "GP5 (I2C SCL)" as PA_SCL #A7F3D0
    }

    package "Pico Victim B on Maker Pi Base\n(UART Listener / I2C Slave)" as PKG_PICO_B #D1FAE5 {
        component "GP1 (UART RX)" as PB_RX #A7F3D0
        component "GP4 (I2C SDA)" as PB_SDA #A7F3D0
        component "GP5 (I2C SCL)" as PB_SCL #A7F3D0
    }

    component "GY-511 Compass\n(LSM303DLHC)" as SENSOR #6EE7B7

    ' Breadboard inter-pico links
    PA_TX --> PB_RX : 3.3V UART Link (115200)
    PA_SDA <--> PB_SDA : 3.3V I2C Bus (SDA)
    PA_SCL <--> PB_SCL : 3.3V I2C Bus (SCL)
    SENSOR --> PB_SDA : I2C SDA
    SENSOR --> PB_SCL : I2C SCL
}

' ==================== NODE 1: DIAGNOSTIC TOOL ====================
package "Node 1: Diagnostic Tool (ESP32-C6 on Maker Pi Base)" as PKG_TOOL #F0F9FF {
    package "Maker Pi Probe Headers (Direct 3.3V)" as TOOL_PROBES #E0F2FE {
        component "Pin 6 (GP4) -> GPIO6"  as T_P0 #BAE6FD
        component "Pin 7 (GP5) -> GPIO7"  as T_P1 #BAE6FD
        component "Pin 9 (GP6) -> GPIO14" as T_P2 #BAE6FD
        component "Pin 10 (GP7) -> GPIO15" as T_P3 #BAE6FD
    }
    
    package "Onboard Baseboard Hardware" as TOOL_BASE #F1F5F9 {
        database "Onboard MicroSD Slot\n(SPI: GPIO18, 19, 20, EXIO7)" as T_SD #CBD5E1
        component "E-Stop Button (Pin 12 / GPIO9 BOOT)" as T_ESTOP #FCA5A5
        component "Status NeoPixel (Pin 11 / GPIO8)" as T_LED #DDD6FE
        component "Piezo Buzzer (Pin 24 / EXIO3)" as T_BUZZ #FEF08A
    }
}

' ==================== NODE 3: WIRELESS VICTIM ====================
package "Node 3: Wireless Victim (ESP32-C6 Node B)" as PKG_WIRELESS #EFF6FF {
    component "Wi-Fi 6 SoftAP\n('VICTIM_AP' | Ch 6)" as W_AP #BFDBFE
    component "802.15.4 Transmitter\n(Raw Data | Ch 15)" as W_ZIGBEE #BFDBFE
}

' --- Direct 3.3V Wire-to-Wire Sniffing & Fault Injection ---
PA_TX --> T_P0  : PROBE_0 (UART TX Sniff/Glitch)
PB_RX <-- T_P1  : PROBE_1 (UART RX Sniff)
PA_SDA <--> T_P2 : PROBE_2 (I2C SDA Sniff/ACK NACK)
PA_SCL <--> T_P3 : PROBE_3 (I2C SCL Sniff/Stretch)

' --- Wireless Over-the-Air Link ---
W_AP -left-> PKG_TOOL : 2.4 GHz RF
W_ZIGBEE -left-> PKG_TOOL : 2.4 GHz RF

@enduml
