CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Primary console through USB-Serial-JTAG (onboard USB-C)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Disable TWDT (unsupported under µT-Kernel scheduler)
CONFIG_ESP_TASK_WDT_EN=n

# Wi-Fi SoftAP & WebSockets
CONFIG_MTK3_WIFI_ENABLED=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_HEAP_TLSF_USE_ROM_IMPL=n
CONFIG_LOG_TAG_LEVEL_IMPL_LINKED_LIST=y
