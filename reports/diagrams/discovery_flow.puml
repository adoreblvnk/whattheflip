@startuml discovery_flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ArrowColor #1E293B

start
:listen on probes, pins high-Z;

repeat
  :sample edge rhythms in 50 ms burst;

  if (matches UART 8.68 µs ±2%?) then (yes)
    :16 valid edges -> lock UART 115200;
    :remap Probe 1 to UART decoder in < 10 ms;
  elseif (matches I2C 1.25 µs ±2%?) then (yes)
    :16 valid edges -> lock I2C 400 kHz;
    :remap Probes 2 & 3 to I2C decoder in < 10 ms;
  else (noise)
    :reset rhythm counter;
  endif
repeat while (both buses locked?) is (no)

:report locked status to dashboard;
:hand off pins to sniffer and fuzzer;
stop
@enduml
