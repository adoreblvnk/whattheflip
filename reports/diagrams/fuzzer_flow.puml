@startuml fuzzer_flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ArrowColor #1E293B

start
:arm fault trigger;
:set status LED to yellow (150 ms);

if (target bus?) then (UART)
  :sync to Start Bit on Probe 1;
  :inject 10 µs bit flip on Probe 0;
  :daphne detects framing/checksum error;
  :daphne turns on GP3 LED, beeps buzzer;
else (I2C)
  :sync to SCL clock on Probe 3;
  :inject 50 µs ACK-kill on Probe 2;
  :daphne detects bus stall, turns on GP2 LED;
  :daphne executes 9-clock recovery & beeps buzzer;
endif

:status LED back to green;
:dispatch alert to dashboard in < 200 ms;
stop
@enduml
