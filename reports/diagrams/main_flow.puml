@startuml main_flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ArrowColor #1E293B

start
:power on, probes idle high-Z (50 ms);
:initialize µT-Kernel 3.0 pools & queues;

partition "concurrent tasks" {
  fork
    :TSK_SAFETY
    e-stop monitor & status LED;
  fork again
    :TSK_DASHBOARD
    SoftAP & 2 Hz web telemetry;
  fork again
    :TSK_DISCOVERY
    bus classification & probe remap;
  fork again
    :TSK_SNIFFER
    passive wired & wireless capture;
  fork again
    :TSK_FUZZER
    synchronized bounded fault injection;
  fork again
    :TSK_STORAGE
    PCAP 2.4 microSD writer;
  end fork
}

if (e-stop pressed?) then (yes)
  :float probes in < 200 ns;
  :status LED red, latch abort state;
  stop
else (normal)
  :system runs continuously;
endif
stop
@enduml
