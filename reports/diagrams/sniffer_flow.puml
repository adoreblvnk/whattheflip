@startuml sniffer_flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ArrowColor #1E293B

start
:listen wired (probes 1..3) and wireless (time-sliced 802.11 / 802.15.4);
:acquire buffer from 32 KB pool (non-blocking);

if (pool buffer acquired?) then (yes)
  fork
    :enqueue to storage queue;
    :TSK_STORAGE writes PCAP 2.4 to microSD;
  fork again
    :enqueue to telemetry queue;
    :TSK_DASHBOARD streams 2 Hz JSON to web UI;
  end fork
else (pool full)
  :drop frame (zero-malloc invariant);
endif

stop
@enduml
